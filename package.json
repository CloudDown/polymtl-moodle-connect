{
  "name": "moodle-ws-mcp",
  "version": "0.1.0",
  "description": "Local MCP server for Moodle students: courses, assignments, grades and discoverable Web Services.",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "moodle",
    "lms",
    "education",
    "mcp-server"
  ],
  "license": "MIT AND GPL-3.0-or-later",
  "type": "module",
  "bin": {
    "moodle-ws-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "catalog",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:binary": "bun build --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig ./scripts/binary-entry.ts --outfile build/moodle-ws-mcp",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "catalog:generate": "node scripts/generate-catalog.mjs",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "jsonc-parser": "^3.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
